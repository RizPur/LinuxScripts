# OpenRouter API Key (used by lang.py / cn / fr for the AI enrichment step)
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional overrides
# AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="deepseek/deepseek-v4-flash"

# --- Remote vocab sync (lang.py sync pulls+merges from the VPS before syncing to Anki) ---
# Leave LANG_REMOTE_SSH unset to disable remote sync (local-only behavior).
LANG_REMOTE_SSH="rizpur"
LANG_REMOTE_CONTAINER="open-terminal"
LANG_REMOTE_DIR="/home/user/lang"
# Set to 0 to skip pushing the merged vocab back to the remote.
# LANG_REMOTE_PUSH="1"

# --- Gemini CLI Scripts ---

# [Chinese Script]
# Path to your central vocabulary JSON file.
# The script will create this file if it doesn't exist.
CHINESE_VOCAB_JSON="/home/joel/dev/scripts/lang/zh/chinese_vocab.json"

# [French Script]
# Path to the directory where French expressions will be stored.
# It's recommended to use the lang/fr/ directory.
FRENCH_DIR="/home/joel/dev/scripts/lang/fr"

# [Chinese Script Config]
# Path to the config file that stores the current HSK level.
CHINESE_CONFIG_FILE="/home/joel/dev/scripts/lang/zh/.cn_config.json"

# [Logs]
# Optional: You can override the default log directory if you wish.
# LOG_DIR="~/dev/scripts/logs"
